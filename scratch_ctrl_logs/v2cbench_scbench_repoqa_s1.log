    GCLogTrace trace;

    if ((trace = GC_COUNT.parse(entry)) != null) {
        int gcId = trace.getIntegerGroup(1);
        GCCause cause = trace.gcCause();
        double duration = trace.getDuration();
        MemoryPoolSummary before = getTotalOccupancyBeforeAfterWithTotalHeapPoolSizeSummary(trace, 3);
        MemoryPoolSummary after = getTotalOccupancyBeforeAfterWithTotalHeapPoolSizeSummary(trace, 9);
        CPUSummary cpuSummary = extractCPUSummary(entry);
        publish(new G1GCPauseEvent(getClock(), gcId, cause, duration, before, after, cpuSummary));
    }
}
