/**
 * Creates a duplicate of an object, ensuring that the new object is a separate instance with the
 * same properties as the original.
 *
 * @param obj the object to duplicate
 * @return a new object that is a copy of the input object
 */
public static Object duplicate(Object obj) {
    if (obj == null) {
        return null;
    }
    try {
        // Retrieve the components of the input object using reflection
        Field[] fields = obj.getClass().getDeclaredFields();
        for (Field field : fields) {
            field.setAccessible(true);
            field.set(obj, field.get(obj));
        }
        return obj;
    } catch (IllegalAccessException e) {
        throw new RuntimeException("Unable to duplicate object", e);
    }
}
