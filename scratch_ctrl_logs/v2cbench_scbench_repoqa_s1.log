/// Compiles Rust source code into executable binaries or libraries.
///
/// # Arguments
///
/// * `roots` - The root targets requested by the user on the command line (does not include dependencies).
/// * `bcx` - The build context containing complete information needed for a build task.
/// * `unit_graph` - The dependency graph of units to compile.
/// * `scrape_units` - The list of all kinds that are involved in this build.
/// * `gctx` - The global context containing various configurations and settings.
///
/// # Returns
///
/// * `Ok(CompilationFiles)` - If the compilation is successful, returns the compiled files and directories.
/// * `Err(CargoResult)` - If there is an error during compilation, returns an error message.
///
/// # Example
///
/// ```
/// let compilation_files = compile(
///     roots,
///     bcx,
///     unit_graph,
///     scrape_units,
///     gctx,
/// ).unwrap();
/// ```
fn compile(
