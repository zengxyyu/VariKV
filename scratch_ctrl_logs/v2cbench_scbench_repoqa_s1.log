    `
    select 
      ${parseFields(fields)}
    from website_event
      ${joinSession}
    where website_event.website_id = {{websiteId::uuid}}
      and website_event.created_at between {{startDate}} and {{endDate}}
      and website_event.event_type = {{eventType}}
      ${filterQuery}
    ${parseGroupBy(fields)}
    order by 1 desc, 2 desc
    limit 500
    `,
    params,
  );
}

