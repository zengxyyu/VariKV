use crate::Rope;
use crate::Transaction;
use crate::tree_sitter::InputEdit;

/// Verifies the correctness of text edits applied to a document and ensures that the resulting changes are accurately reflected in the document's structure.
///
/// # Arguments
///
/// * `doc` - The document represented as a string.
/// * `changeset` - A series of text changes (insertions, deletions, or replacements).
/// * `expectations` - The expected edits in terms of byte ranges and positions.
///
/// # Panics
///
/// Panics if the generated edits do not match the expected edits or if the document content does not match the expected result after applying the edits.
fn verify_edits(doc: &str, changeset: &Transaction, expectations: Vec<InputEdit>) {
    let mut state = Rope::from(doc);
    let edits = generate_edits(state.slice(..), changeset.changes());
    assert_eq!(edits, expectations);

    changeset.apply(&mut state);
    assert_eq!(state, Rope::from(expectations.join("")));
}
