use crate::Parser;

fn escaped_transform<I, E>(
    inner: I,
    escape: char,
    escapes: impl Fn(char) -> IResult<I, I, E>,
) -> impl Fn(I) -> IResult<I, String, E>
where
    I: Input,
    I: for<'a> Compare<&'a [u8]>,
    <I as Input>::Item: AsChar,
    E: ParseError<I>,
{
    move |input: I| {
        let mut result = String::new();
        let mut remaining = input;
        loop {
            match remaining.split_at_position(|item| item.as_char() == escape) {
                Ok((before_escape, escape_char)) => {
                    if before_escape.is_empty() {
                        return Err(Err::Incomplete(Needed::new(1)));
                    }
                    let (escaped, rest) = escapes(escape_char.as_char()).parse(before_escape)?;
                    remaining = rest;
                    result.push_str(&escaped);
                }
                Err(_) => {
                    if remaining.is_empty() {
                        return Ok((remaining, result));
                    }
                    return Err(Err::Error(E::from_error_kind(
                        remaining,
                        ErrorKind::EscapedTransform,
                    )));
                }
            }
        }
    }
}
