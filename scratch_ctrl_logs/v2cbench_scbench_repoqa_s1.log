static OpenSSLKey fromECPrivateKeyForTLSStackOnly(
        PrivateKey key, ECParameterSpec ecParams) throws InvalidKeyException {
    OpenSSLKey result = getOpenSSLKey(key);
    if (result != null) {
        return result;
    }

    result = fromKeyMaterial(key);
    if (result != null) {
