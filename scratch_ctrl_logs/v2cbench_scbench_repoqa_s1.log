    if (base instanceof MemberSelectTree) {
        MemberSelectTree selectTree = (MemberSelectTree) base;
        scan(selectTree.getExpression(), null);
        token(".");
        visitAnnotations(node.getAnnotations(), BreakOrNot.NO, BreakOrNot.NO);
