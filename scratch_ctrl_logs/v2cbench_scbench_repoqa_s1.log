@Override
public final int selectApplicationProtocol(byte[] applicationProtocols) {
    if (applicationProtocols == null) {
        throw new IllegalArgumentException("applicationProtocols array must be non-null");
    }

    if (applicationProtocols.length == 0) {
        return -1;
    }

    // Calculate the encoded length.
    int length = 0;
    for (int i = 0; i < applicationProtocols.length; ++i) {
        int protocolLength = applicationProtocols[i];
        if (protocolLength == 0 || protocolLength > MAX_PROTOCOL_LENGTH) {
            throw new IllegalArgumentException(
                "protocol[" + i + "] has invalid length: " + protocolLength);
        }

        length += 1 + protocolLength;
    }

    byte[] data = new byte[length];
    int dataIndex = 0;
    for (int i = 0; i < applicationProtocols.length; ++i) {
        int protocolLength = applicationProtocols[i];
        System.arraycopy(applicationProtocols, i + 1, data, dataIndex, protocolLength);
        dataIndex += protocolLength;
    }

    // Find the common protocol
    for (int i = 0; i < data.length; ++i) {
        int protocolLength = data[i];
        if (protocolLength == 0) {
            continue;
        }

        byte[] protocol = new byte[protocolLength];
        System.arraycopy(data, i + 1, protocol, 0, protocolLength);
        if (isApplicationProtocolSupported(protocol)) {
            return i;
        }
    }

    return -1;
}

