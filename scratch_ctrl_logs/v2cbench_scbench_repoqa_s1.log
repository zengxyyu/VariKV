use crate::error::ErrorKind;
use crate::internal::{Err, IResult, Needed};
use crate::Parser;

/// Recognizes an 8-bit signed integer.
///
/// *Streaming version*: Will return `Err(nom::Err::Incomplete(_))` if there's not enough input data,
/// or if no terminating token is found (a non signed digit character).
/// # Example
///
/// ```
/// # use nom::{Err, error::ErrorKind, IResult, Needed};
/// # use nom::number::streaming::le_i8;
/// assert_eq!(le_i8::<_, (_, ErrorKind)>(b"\x00"[..]), Ok((&b""[..], 0)));
/// assert_eq!(le_i8::<_, (_, ErrorKind)>(b"\x7f"[..]), Ok((&b""[..], 127)));
/// assert_eq!(le_i8::<_, (_, ErrorKind)>(b"\xff"[..]), Ok((&b""[..], -1)));
/// assert_eq!(le_i8::<_, (_, ErrorKind)>(b"\x80"[..]), Ok((&b""[..], -128)));
/// assert_eq!(le_i8::<_, (_, ErrorKind)>(b""[..]), Err(Err::Incomplete(Needed::new(1))));
/// ```
pub fn le_i8<T, E: ParseError<T>>(input: T) -> IResult<T, i8, E>
where
  T: Input,
  <T as Input>::Item: AsChar,
{
  let (i, s) = super::le_u8(input).map(|x| x as i8).parse(input)?;
  if s == 0 {
    Err(Err::Incomplete(Needed::new(1)))
  } else {
    Ok((i, s))
  }
}
