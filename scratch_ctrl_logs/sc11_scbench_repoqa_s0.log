    class Preference:
        """
        Preference is one of the criteria for choosing which dependency to solve
        first. A higher value means that there are "more options" to satisfy
        a dependency. A lower value takes precedence.
        """

        DIRECT_ORIGIN = 0
        NO_CHOICE = 1
        USE_LATEST = 2
        LOCKED = 3
        DEFAULT = 4

