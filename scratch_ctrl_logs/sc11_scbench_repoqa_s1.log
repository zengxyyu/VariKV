class reactor_backend_selector {
    std::string _name;
private:
    static bool has_enough_aio_nr();
    explicit reactor_backend_selector(std::string name) : _name(std::move(name)) {}
public:
    const std::string& name() const { return _name; }
    std::unique_ptr<reactor_backend> create(reactor& r);
    static reactor_backend_selector default_backend();
    static std::vector<reactor_backend_selector> available();
    friend std::ostream& operator<<(std::ostream& os, const reactor_backend_selector& rbs) {
        return os << rbs._name;
    }
};

reactor_backend_selector::reactor_backend_selector(std::string name) : _name(std::move(name)) {}

std::unique_ptr<reactor_backend> reactor_backend_selector::create(reactor& r) {
    if (_name == "epoll") {
        return std::make_unique<reactor_backend_epoll>(r);
    } else if (_name == "aio") {
        return std::make_unique<reactor_backend_aio>(r);
#ifdef HAVE_OSV
    } else if (_name == "osv") {
        return std::make_unique<reactor_backend_osv>();
#endif
    }
    throw std::runtime_error("Unsupported backend: " + _name);
}

reactor_backend_selector reactor_backend_selector::default_backend() {
    if (has_enough_aio_nr()) {
        return reactor_backend_selector("aio");
    } else {
        return reactor_backend_selector("epoll");
    }
}

std::vector<reactor_backend_selector> reactor_backend_selector::available() {
    std::vector<reactor_backend_selector> backends;
    if (has_enough_aio_nr()) {
        backends.push_back(reactor_backend_selector("aio"));
    }
    backends.push_back(reactor_backend_selector("epoll"));
#ifdef HAVE_OSV
    backends.push_back(reactor_backend_selector("osv"));
#endif
    return backends;
}

