def join_terms(terms: list[str]) -> str:
    """
    Joins a list of terms into a single string, with each term separated by 'and'.
    
    Parameters:
    terms (list[str]): A list of terms to be joined.

    Returns:
    str: A single string with all terms separated by 'and'.
    """
    if not terms:
        return ""
    
    if len(terms) == 1:
        return terms[0]
    
    return " and ".join(terms[:-1]) + " and " + terms[-1]
