private static void processScenarioOutline(Context context, ScenarioOutline scenarioOutline) {
    FeatureSection section = new FeatureSection();
    scenarioOutline.setSection(section);
    feature.addSection(section);
    
    if (scenarioOutline.getTags() != null) {
        scenarioOutline.setTags(convertTags(scenarioOutline.getTags()));
    }
    
    if (scenarioOutline.getDescription() != null) {
        StringUtils.Pair pair = StringUtils.splitByFirstLineFeed(scenarioOutline.getDescription());
        scenarioOutline.setName(pair.left);
        scenarioOutline.setDescription(pair.right);
    }
    
    List<Step> steps = convertSteps(scenarioOutline.getSteps());
    scenarioOutline.setSteps(steps);
    
    List<ExamplesTable> examples = new ArrayList<>();
    scenarioOutline.setExamples(examples);
    
    for (ExampleContext exampleContext : scenarioOutline.getExamples()) {
        Table table = convertTable(exampleContext.getTable());
        ExamplesTable example = new ExamplesTable(table);
        examples.add(example);
        
        if (exampleContext.getTags() != null) {
            example.setTags(convertTags(exampleContext.getTags()));
        }
        
        if (logger.isTraceEnabled()) {
            logger.trace("example rows: {}", table.getRows());
        }
    }
    
    if (logger.isTraceEnabled()) {
        logger.trace("outline steps: {}", steps);
    }
}

private static List<Tag> convertTags(List<Tag> tags) {
    if (tags == null) {
        return Collections.emptyList();
    }
    return tags.stream().map(Tag::new).collect(Collectors.toList());
}

private static List<Step> convertSteps(List<Step> steps) {
    if (steps == null) {
        return Collections.emptyList();
    }
    return steps.stream().map(Step::new).collect(Collectors.toList());
}

private static Table convertTable(Table table) {
    if (table == null) {
        return null;
    }
    return new Table(table.getRows(), table.getLineNumbers());
}
