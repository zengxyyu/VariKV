protected void encipher(int[] lr, int off, int[] pArray, int[] sBox) {
    int i;
    int n;
    int l = lr[off];
    int r = lr[off + 1];

    l ^= pArray[0];
    for (i = 0; i <= BLOWFISH_NUM_ROUNDS - 2; ) {
        n = feistelSubstitution(l, sBox);
        r ^= n ^ pArray[++i];
        n = feistelSubstitution(r, sBox);
        l ^= n ^ pArray[++i];
    }
    lr[off] = r ^ pArray[BLOWFISH_NUM_ROUNDS + 1];
    lr[off + 1] = l;
}
