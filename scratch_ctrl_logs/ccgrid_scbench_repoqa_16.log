from pathlib import Path

from poetry.utils.helpers import extractall

def _extract_archive(archive: Path, destination: Path | None = None) -> Path:
    """
    Extracts a source distribution (sdist) archive into a temporary directory for further processing.

    :param archive: The path to the archive file to be extracted.
    :param destination: The optional path to the destination directory where the extracted contents will be placed.
    :return: The path to the directory where the archive has been extracted.
    """
    if not archive.is_file():
        raise ValueError(f"Invalid archive path: {archive}")

    suffix = archive.suffix
    zip = suffix == ".zip"

    if suffix == ".bz2":
        suffixes = archive.suffixes
        if len(suffixes) > 1 and suffixes[-2] == ".tar":
            suffix = ".tar.bz2"
    elif not zip:
        suffix = ".tar.gz"

    with temporary_directory() as tmp_str:
        tmp = Path(tmp_str)
        extractall(source=archive, dest=tmp, zip=zip)

        # a little bit of guess work to determine the directory we care about
        elements = list(tmp.glob("*"))

        if len(elements) == 1 and elements[0].is_dir():
            sdist_dir = elements[0]
        else:
            sdist_dir = tmp / archive.name.rstrip(suffix)
            if not sdist_dir.is_dir():
                sdist_dir = tmp

        # now this is an unpacked directory we know how to deal with
        if destination is None:
            return sdist_dir

        # if we have a destination, we need to move the contents to it
        if sdist_dir.is_dir():
            for element in sdist_dir.iterdir():
                element.replace(destination / element.name)
        else:
            sdist_dir.replace(destination)

        return destination
